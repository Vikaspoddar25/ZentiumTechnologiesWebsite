# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://zentiumtechnologies.com

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Sender must be on a domain verified in Resend (gmail.com cannot be used).
# Before verification, use onboarding@resend.dev — it only delivers to the
# Resend account owner's email, so CONTACT_TO_EMAIL must match that address.
CONTACT_FROM_EMAIL=Zentium Website <hello@zentiumtechnologies.com>
# Where enquiries land
CONTACT_TO_EMAIL=info.zentiumtechnologies@gmail.com

# Optional: Calendly scheduling link
NEXT_PUBLIC_CALENDLY_URL=

# Optional: Google Analytics 4
NEXT_PUBLIC_GA_ID=
